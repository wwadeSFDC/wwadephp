<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assignment_BuildSummary</name>
        <label>Build Summary</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outputSummary</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Summary_Text</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assignment_IncrementAged</name>
        <label>Increment Aged Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outputAgedCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Cases</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assignment_IncrementEscalated</name>
        <label>Increment Escalated Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outputEscalatedCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Decision_IsAged</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assignment_IncrementInProgress</name>
        <label>Increment In Progress Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outputInProgressCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Decision_IsEscalated</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assignment_IncrementNew</name>
        <label>Increment New Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outputNewCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Decision_IsInProgress</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assignment_IncrementTotal</name>
        <label>Increment Total Open Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outputTotalOpen</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Decision_IsNew</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assignment_LocationNotFound</name>
        <label>Set Location Not Found Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outputErrorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>NotFound_Text</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Fault_SetError</name>
        <label>Fault - Set Error Message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outputErrorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Decision_IsAged</name>
        <label>Open Longer Than 7 Days?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Cases</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Aged</defaultConnectorLabel>
        <rules>
            <name>Aged</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Cases.CreatedDate</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Formula_SevenDaysAgo</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_IncrementAged</targetReference>
            </connector>
            <label>Aged</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_IsEscalated</name>
        <label>High Priority or Escalated?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Decision_IsAged</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Escalated</defaultConnectorLabel>
        <rules>
            <name>Escalated</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Cases.Priority</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>High</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Cases.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Escalated</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_IncrementEscalated</targetReference>
            </connector>
            <label>Escalated</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_IsInProgress</name>
        <label>In Progress or Working?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Decision_IsEscalated</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not In Progress</defaultConnectorLabel>
        <rules>
            <name>InProgress</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Cases.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>In Progress</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Cases.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Working</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_IncrementInProgress</targetReference>
            </connector>
            <label>In Progress</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_IsNew</name>
        <label>Status Is New?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Decision_IsInProgress</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not New</defaultConnectorLabel>
        <rules>
            <name>New</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Cases.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_IncrementNew</targetReference>
            </connector>
            <label>New</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_LocationFound</name>
        <label>Location Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_OpenCases</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Location Found</defaultConnectorLabel>
        <rules>
            <name>LocationNotFound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varLocation</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_LocationNotFound</targetReference>
            </connector>
            <label>Location Not Found</label>
        </rules>
    </decisions>
    <description>Each case is classified independently by status/priority/age, so a single case can increment more than one bucket (e.g. New and Aged).</description>
    <environments>Default</environments>
    <formulas>
        <name>Formula_SevenDaysAgo</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - 7</expression>
    </formulas>
    <interviewLabel>PHP Get Maintenance Backlog {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PHP Get Maintenance Backlog</label>
    <loops>
        <name>Loop_Cases</name>
        <label>Loop Cases</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>varOpenCases</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assignment_IncrementTotal</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Assignment_BuildSummary</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Location</name>
        <label>Get Location</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_LocationFound</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Fault_SetError</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inputPropertyName</elementReference>
            </value>
        </filters>
        <object>Apt_Location__c</object>
        <outputReference>varLocation</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_OpenCases</name>
        <label>Get Open Cases</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Cases</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Fault_SetError</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Property__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varLocation.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </filters>
        <object>Case</object>
        <outputReference>varOpenCases</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Subject</queriedFields>
        <queriedFields>Status</queriedFields>
        <queriedFields>Priority</queriedFields>
        <queriedFields>CreatedDate</queriedFields>
    </recordLookups>
    <runInMode>DefaultMode</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Location</targetReference>
        </connector>
    </start>
