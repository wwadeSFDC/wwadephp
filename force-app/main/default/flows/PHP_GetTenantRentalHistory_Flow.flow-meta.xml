        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Payments</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Past Due</defaultConnectorLabel>
        <rules>
            <name>PastDue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Payments.Past_Due__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_IncrementPastDue</targetReference>
            </connector>
            <label>Past Due</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_UnderCap</name>
        <label>Under 24 Cap?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Payments</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Cap Reached</defaultConnectorLabel>
        <rules>
            <name>UnderCap</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>outputCount</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>24.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_AddPayment</targetReference>
            </connector>
            <label>Under Cap</label>
        </rules>
    </decisions>
    <description>Caps returned payments at 24 via a loop counter, since Get Records has no native row-limit setting.</description>
