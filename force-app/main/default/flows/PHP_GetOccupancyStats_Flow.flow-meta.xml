    <decisions>
        <name>Decision_HasRecordId</name>
        <label>Has Record Id?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Location</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Record Id</defaultConnectorLabel>
        <rules>
            <name>RecordIdProvided</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Location_ById</targetReference>
            </connector>
            <label>Record Id Provided</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_IsOccupied</name>
        <label>Is Occupied?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assignment_IncrementVacant</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Vacant</defaultConnectorLabel>
        <rules>
            <name>Occupied</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Apartments.Occupied__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_IncrementOccupied</targetReference>
            </connector>
            <label>Occupied</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_LocationFound</name>
        <label>Location Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Apartments</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Location Found</defaultConnectorLabel>
        <rules>
            <name>LocationNotFound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varLocation</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_LocationNotFound</targetReference>
            </connector>
            <label>Location Not Found</label>
        </rules>
    </decisions>
    <description>Computes occupancy stats for a property. Can be invoked with either a recordId (e.g. from the current Apt_Location__c record page) or an inputPropertyName (lookup by Name from anywhere else). recordId takes priority when both are provided. Occupancy rate formula guards against divide-by-zero when a property has no apartments.</description>
    <environments>Default</environments>
    <formulas>
        <name>Formula_NotFoundIdentifier</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!inputPropertyName}), {!recordId}, {!inputPropertyName})</expression>
    </formulas>
    <formulas>
        <name>Formula_OccupancyRate</name>
        <dataType>Number</dataType>
        <expression>IF({!outputTotalUnits} = 0, 0, ROUND(({!outputOccupiedUnits} / {!outputTotalUnits}) * 100, 2))</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>PHP Get Occupancy Stats {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PHP Get Occupancy Stats</label>
    <loops>
        <name>Loop_Apartments</name>
        <label>Loop Apartments</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>varApartments</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Decision_IsOccupied</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Assignment_SetOccupancyRate</targetReference>
        </noMoreValuesConnector>
    </loops>
