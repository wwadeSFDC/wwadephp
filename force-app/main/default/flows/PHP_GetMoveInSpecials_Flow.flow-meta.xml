    <decisions>
        <name>Decision_IsCurrentOrUpcoming</name>
        <label>Is Current or Upcoming?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Specials</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Past Period</defaultConnectorLabel>
        <rules>
            <name>CurrentOrUpcoming</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formulaSpecialPeriodNum</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>formulaCurrentPeriodNum</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_AddSpecial</targetReference>
            </connector>
            <label>Current or Upcoming</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_MatchesLocation</name>
        <label>Matches Location Filter?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Specials</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Match</defaultConnectorLabel>
        <rules>
            <name>Matches</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>locationFilter</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varSpecialLocation.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>locationFilter</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varSpecialLocation.City__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>locationFilter</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Decision_IsCurrentOrUpcoming</targetReference>
            </connector>
            <label>Matches</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Were_Specials_Found</name>
        <label>Were Specials Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assignment_Set_No_Specials_Message</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Specials Found</defaultConnectorLabel>
        <rules>
            <name>SpecialsFound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>specialsCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <label>Specials Found</label>
        </rules>
    </decisions>
    <description>locationFilter is optional; when provided it matches against the special&apos;s Apt Location neighborhood name or city. &quot;Current or upcoming&quot; specials are those whose Month__c/Year__c has not yet passed relative to today (Move_in_Specials__c has no Active__c/Expiration_Date__c field).</description>
    <environments>Default</environments>
    <formulas>
        <name>formulaCurrentPeriodNum</name>
        <dataType>Number</dataType>
        <expression>YEAR(TODAY()) * 12 + MONTH(TODAY())</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formulaSpecialMonthNum</name>
        <dataType>Number</dataType>
        <expression>CASE({!Loop_Specials.Month__c}, &quot;January&quot;,1, &quot;February&quot;,2, &quot;March&quot;,3, &quot;April&quot;,4, &quot;May&quot;,5, &quot;June&quot;,6, &quot;July&quot;,7, &quot;August&quot;,8, &quot;September&quot;,9, &quot;October&quot;,10, &quot;November&quot;,11, &quot;December&quot;,12, 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formulaSpecialPeriodNum</name>
        <dataType>Number</dataType>
        <expression>{!Loop_Specials.Year__c} * 12 + {!formulaSpecialMonthNum}</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>PHP Get Move-In Specials {!$Flow.CurrentDateTime}</interviewLabel>
