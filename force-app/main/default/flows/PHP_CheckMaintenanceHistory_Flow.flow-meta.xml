<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assignment_AddCase</name>
        <label>Add Case to Results</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outputCases</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Cases</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outputCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Cases</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Fault_SetError</name>
        <label>Fault - Set Error Message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outputErrorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Decision_HasStatusFilter</name>
        <label>Status Filter Provided?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Cases_NonClosed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Status Filter</defaultConnectorLabel>
        <rules>
            <name>HasStatusFilter</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>inputStatusFilter</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Cases_WithStatus</targetReference>
            </connector>
            <label>Has Status Filter</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_UnderCap</name>
        <label>Under 50 Cap?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Cases</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Cap Reached</defaultConnectorLabel>
        <rules>
            <name>UnderCap</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>outputCount</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>50.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_AddCase</targetReference>
            </connector>
            <label>Under Cap</label>
        </rules>
    </decisions>
    <description>Caps returned Cases at 50 via a loop counter, since Get Records has no native row-limit setting.</description>
    <environments>Default</environments>
    <interviewLabel>PHP Check Maintenance History {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PHP Check Maintenance History</label>
    <loops>
