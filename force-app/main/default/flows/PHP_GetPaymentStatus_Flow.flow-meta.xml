<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assignment_AccumulatePayment</name>
        <label>Accumulate Overdue Payment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outputOverdueCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outputOverdueTotalAmount</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Payments.Rent_Amount__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Payments</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assignment_LocationNotFound</name>
        <label>Set Location Not Found Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outputErrorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>NotFound_Text</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assignment_SetAllCurrentSummary</name>
        <label>Set All Current Summary</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outputSummary</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>AllCurrent_Text</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assignment_SetOverdueSummary</name>
        <label>Set Overdue Summary</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outputSummary</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Summary_Text</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Fault_SetError</name>
        <label>Fault - Set Error Message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outputErrorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Decision_AnyOverdue</name>
        <label>Any Overdue Payments?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assignment_SetOverdueSummary</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Has Overdue Payments</defaultConnectorLabel>
        <rules>
            <name>NoOverdue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>outputOverdueCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_SetAllCurrentSummary</targetReference>
            </connector>
            <label>No Overdue</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_LocationFound</name>
        <label>Location Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_OverduePayments</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Location Found</defaultConnectorLabel>
        <rules>
            <name>LocationNotFound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varLocation</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_LocationNotFound</targetReference>
            </connector>
            <label>Location Not Found</label>
        </rules>
    </decisions>
    <description>Surfaces unit-level overdue payment totals only; never queries or exposes tenant/contact names. Queries Lease_Payment__c directly via the Apartment__r.Apt_Location__c relationship, so only 2 SOQL queries run (Location lookup + Payments), staying well under the governor limit.</description>
    <environments>Default</environments>
    <interviewLabel>PHP Get Payment Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PHP Get Payment Status</label>
    <loops>
        <name>Loop_Payments</name>
        <label>Loop Payments</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>varOverduePayments</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assignment_AccumulatePayment</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Decision_AnyOverdue</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Location</name>
        <label>Get Location</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_LocationFound</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Fault_SetError</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inputPropertyName</elementReference>
            </value>
        </filters>
        <object>Apt_Location__c</object>
        <outputReference>varLocation</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_OverduePayments</name>
        <label>Get Overdue Payments</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Payments</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Fault_SetError</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Past_Due__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Location_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varLocation.Name</elementReference>
            </value>
        </filters>
        <object>Lease_Payment__c</object>
        <outputReference>varOverduePayments</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Rent_Amount__c</queriedFields>
        <queriedFields>Date_Due__c</queriedFields>
        <queriedFields>Apartment__c</queriedFields>
    </recordLookups>
    <runInMode>DefaultMode</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Location</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>AllCurrent_Text</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>All lease payments are current for {!inputPropertyName}.</text>
    </textTemplates>
    <textTemplates>
        <name>NotFound_Text</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Property not found: {!inputPropertyName}</text>
    </textTemplates>
    <textTemplates>
        <name>Summary_Text</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>{!outputOverdueCount} overdue payment(s) totalling ${!outputOverdueTotalAmount} across {!outputOverdueCount} unit(s).</text>
    </textTemplates>
    <variables>
        <name>inputPropertyName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>outputErrorMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>outputOverdueCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>outputOverdueTotalAmount</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>2</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>outputSummary</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varLocation</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Apt_Location__c</objectType>
    </variables>
    <variables>
        <name>varOverduePayments</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Lease_Payment__c</objectType>
    </variables>
</Flow>
